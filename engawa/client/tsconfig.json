{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "bun-types"],
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"], "@shared/*": ["../shared/*"] }
  },
  "include": ["src/**/*", "../shared/**/*"]
}
