# Production env sample. From inside this directory:
#   cp .env.example .env   then edit the values below.

# Public domain Caddy obtains a Let's Encrypt cert for. Its DNS A/AAAA record
# must point at this host, and ports 80/443 must be reachable from the internet.
ENGAWA_DOMAIN=engawa.example.com

# Email for the ACME (Let's Encrypt) account — used for expiry notices.
# Optional but recommended. Leave empty to register anonymously.
ACME_EMAIL=admin@example.com

# Image to pull. Pin a version tag (e.g. :v1.2.3) for reproducible deploys
# instead of :latest. Published to GHCR by .github/workflows/release.yml.
ENGAWA_IMAGE=ghcr.io/iitenkida7/engawa:latest

# Cloudflare Realtime TURN (optional). If unset, NAT traversal falls back to
# STUN only. Kept server-side; only short-lived credentials reach the browser.
CLOUDFLARE_TURN_TOKEN_ID=
CLOUDFLARE_TURN_TOKEN_SECRET=

# Optional workspace password protection. JSON object mapping workspace -> password:
#   WORKSPACE_PASSWORDS={"ws1":"pass1","ws2":"pass2"}
# Invalid JSON is ignored (all workspaces open). Separate rooms via ?workspace= in the URL.
WORKSPACE_PASSWORDS=
