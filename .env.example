PORT=3000
CLOUDFLARE_TURN_TOKEN_ID=
CLOUDFLARE_TURN_TOKEN_SECRET=
# Cloudflare Realtime SFU (large-group / meeting-room calls). Unset → SFU is
# disabled and every group uses the P2P mesh (same behaviour as before SFU).
CLOUDFLARE_REALTIME_APP_ID=
CLOUDFLARE_REALTIME_APP_TOKEN=
# Open-floor cluster size at which a group switches from the P2P mesh to the SFU
# (default 2 = every call with 2 or more people goes through the SFU). Set to 4
# to keep 2-3 person chats on direct P2P. Ignored when the SFU is not configured.
SFU_PROMOTE_AT=

# The map to run: the name of a bundled preset (maps/*.json, default: office_medium)
# or the URL of an external map JSON. A map that fails validation stops the boot.
MAP=

# Event webhook (optional, see docs/webhook.md). When set, the server POSTs a JSON
# event as people join/leave and conversations start/end. Unset → disabled.
EVENT_WEBHOOK_URL=
# Optional HMAC-SHA256 key; signs each body into the X-Engawa-Signature header.
EVENT_WEBHOOK_SECRET=
# true → participants are sent by display name; otherwise an anonymous daily id.
EVENT_INCLUDE_NAMES=

# Transcription (optional). Normally each person brings their own Groq key in
# their browser; set this to provide ONE key for everyone in the space. Served
# only to joined sessions (see docs/control-plane.md).
GROQ_API_KEY=

# Control plane (optional, see docs/control-plane.md). When set, the server also
# fetches its settings from this URL and refreshes them periodically, so they can
# change without a restart — a restart disconnects everyone in the office. Unset
# → the environment is the only source (the normal self-hosted case).
# Must be https (http is allowed only for localhost).
CONTROL_PLANE_URL=
# REQUIRED whenever CONTROL_PLANE_URL is set: sent as `Authorization: Bearer
# <token>`, and the key the response signature is verified with. Issue one per
# server, never a shared one.
CONTROL_PLANE_TOKEN=
# Refresh interval in seconds (default 60, floored at 10).
CONTROL_PLANE_INTERVAL_S=

# How entry is gated (optional, see docs/entry-token.md). Unset or `password` →
# the shared ACCESS_PASSWORD, exactly as before. `token` → entry is by a ticket
# the control plane signs and links to (`/?t=…`), verified locally against
# CONTROL_PLANE_TOKEN (required in that mode), with the display name taken from
# the ticket instead of being typed. The two gates are exclusive.
ENTRY_MODE=
