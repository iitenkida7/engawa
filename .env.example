PORT=3000
CLOUDFLARE_TURN_TOKEN_ID=
CLOUDFLARE_TURN_TOKEN_SECRET=
# Cloudflare Realtime SFU (large-group / meeting-room calls). Unset → SFU is
# disabled and every group uses the P2P mesh (same behaviour as before SFU).
CLOUDFLARE_REALTIME_APP_ID=
CLOUDFLARE_REALTIME_APP_TOKEN=
# Open-floor cluster size at which a group switches from the P2P mesh to the SFU
# (default 2 = every call with 2 or more people goes through the SFU). Set to 4
# to keep 2-3 person chats on direct P2P. Ignored when the SFU is not configured.
SFU_PROMOTE_AT=

# Event webhook (optional, see docs/webhook.md). When set, the server POSTs a JSON
# event as people join/leave and conversations start/end. Unset → disabled.
EVENT_WEBHOOK_URL=
# Optional HMAC-SHA256 key; signs each body into the X-Engawa-Signature header.
EVENT_WEBHOOK_SECRET=
# true → participants are sent by display name; otherwise an anonymous daily id.
EVENT_INCLUDE_NAMES=
